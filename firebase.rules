rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Funções Auxiliares (Helpers)
    // ==========================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é o dono do próprio documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // Regras de Coleções
    // ==========================================

    // Coleção: users (Perfis gerais de usuários)
    match /users/{userId} {
      // Qualquer usuário autenticado pode ler os perfis (ex: nome, avatar)
      allow read: if isAuthenticated();
      // Apenas o próprio usuário pode criar ou atualizar seu documento de perfil
      allow create, update: if isOwner(userId);
      allow delete: if false; // Evita exclusão acidental de perfil
    }

    // Coleção: guides (Credenciamento de guias e CADASTUR)
    match /guides/{userId} {
      // Qualquer usuário autenticado pode visualizar os dados dos guias
      allow read: if isAuthenticated();
      // Apenas o próprio guia pode cadastrar/editar suas informações profissionais
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Coleção: trails (Catálogo de trilhas)
    match /trails/{trailId} {
      // Qualquer pessoa autenticada pode listar e ver detalhes das trilhas
      allow read: if isAuthenticated();
      // Qualquer usuário autenticado pode cadastrar novas trilhas
      allow create: if isAuthenticated();
      // Permite atualização de dados da trilha por usuários autenticados
      allow update: if isAuthenticated();
      allow delete: if false;

      // Subcoleção: reviews (Avaliações das trilhas)
      match /reviews/{reviewId} {
        // Leitura livre para usuários autenticados
        allow read: if isAuthenticated();
        // Apenas o autor da avaliação pode criá-la com seu próprio userId
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        // Apenas o autor pode deletar sua própria avaliação
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

  }
}